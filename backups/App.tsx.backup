            </div>
          </div>

          <div className="flex bg-white p-1 rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
            {['ans', 'bai', 'isi', 'concentration', 'cfs'].map(t => (
              <button key={t} onClick={() => setActiveTab(t as any)} className={`flex-1 py-3 text-sm font-bold rounded-xl transition-all ${activeTab === t ? 'bg-slate-900 text-white' : 'text-slate-400 hover:bg-slate-50'}`}>
                {t === 'bai' ? 'Î∂àÏïà (BAI)' : t === 'isi' ? '?òÎ©¥ (ISI)' : t === 'concentration' ? 'ÏßëÏ§ë?? : t.toUpperCase()}
              </button>
            ))}
          </div>

          <div className="animate-in fade-in duration-300">
            {activeTab === 'ans' && (
