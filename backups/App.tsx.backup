                  <div key={k} className="space-y-1">
                    <label className="text-xs font-bold text-slate-500 uppercase">{k}</label>
                    <input type="number" step="0.01" value={hrv[k as keyof HRVData] as number} onChange={e => setHrv({ ...hrv, [k]: Number(e.target.value) })} className="w-full p-2 bg-slate-50 border rounded-xl" />
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div className="flex gap-4">
            <button onClick={() => setStep('protocol')} className="flex-1 py-4 bg-white border border-slate-200 text-slate-600 font-bold rounded-2xl hover:bg-slate-50 transition-all">Back</button>
            <button onClick={() => setStep('eeg')} className="flex-[2] py-4 bg-blue-600 text-white font-bold rounded-2xl shadow-lg hover:bg-blue-700 transition-all">Next: EEG Analysis</button>
          </div>
        </div>
      </Layout>
    );
  }

  if (step === 'eeg') {
    return (
      <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu} isDarkMode={isDarkMode} onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}>
        <div className="max-w-4xl mx-auto space-y-8 animate-in fade-in duration-500 pb-20">
          <div className="text-center">
            <h2 className="text-3xl font-extrabold text-slate-900">Step 5: EEG Biometrics</h2>
            <p className="text-slate-500 mt-2">Ï¢ÖÌï© ?åÌåå Î∂ÑÏÑù Î¶¨Ìè¨?∏Ïùò ?∞Ïù¥?∞Î? ?ÖÎ†•?òÏã≠?úÏò§.</p>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
            {/* Ï¢ÖÌï© ?åÌåå Î∂ÑÏÑù */}
            <div className="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-8">
              <div className="flex items-center gap-2 border-b border-slate-100 pb-4">
                <div className="w-2 h-6 bg-violet-600 rounded-full"></div>
                <h3 className="font-bold text-slate-800 text-xl">Ï¢ÖÌï© ?åÌåå Î∂ÑÏÑù</h3>
              </div>

              <div className="space-y-6">
                <div className="bg-violet-50 p-6 rounded-2xl border border-violet-100">
                  <label className="block text-sm font-bold text-violet-800 mb-2">?êÎáå Í±¥Í∞ï?êÏàò (Brain Score)</label>
                  <div className="flex items-center gap-4">
                    <input type="number" value={hrv.brainScore} onChange={e => setHrv({ ...hrv, brainScore: Number(e.target.value) })} className="flex-1 p-4 bg-white border border-violet-200 rounded-xl font-black text-2xl text-violet-600 text-center" />
                    <span className="font-bold text-violet-400 text-xl">??/span>
                  </div>
                </div>

                <div className="space-y-4">
                  <label className="block text-sm font-bold text-slate-700">?åÌåå ÎπÑÏú® (%) Î∞??∏Î? ?åÌòï ?†ÌÉù</label>
                  <div className="grid grid-cols-2 gap-4">
                    {[
                      { label: 'Gamma', key: 'eegGamma' },
                      { label: 'H-Beta', key: 'eegHBeta' },
                      { label: 'M-Beta', key: 'eegMBeta' },
                      { label: 'L-Beta', key: 'eegLBeta' },
                      { label: 'Alpha', key: 'eegAlpha' },
                      { label: 'Theta', key: 'eegTheta' }
                    ].map(item => (
                      <div key={item.key} className={`p-4 rounded-2xl border transition-all flex flex-col gap-2 ${hrv.dominantEEG === item.label ? 'bg-indigo-600 border-indigo-600 text-white shadow-md' : 'bg-slate-50 border-slate-200 text-slate-600'}`}>
                        <div className="flex justify-between items-center">
                          <span className="text-xs font-bold uppercase tracking-wider">{item.label}</span>
                          <input
                            type="radio"
                            name="dominantEEG"
                            checked={hrv.dominantEEG === item.label}
                            onChange={() => setHrv({ ...hrv, dominantEEG: item.label })}
                            className="accent-white h-4 w-4"
                          />
                        </div>
                        <input
                          type="number"
                          step="0.1"
                          value={hrv[item.key as keyof HRVData] as number}
                          onChange={e => setHrv({ ...hrv, [item.key]: Number(e.target.value) })}
                          className={`w-full p-2 bg-white/10 border border-white/20 rounded-lg text-sm font-bold focus:outline-none ${hrv.dominantEEG === item.label ? 'text-white' : 'text-slate-900 bg-white border-slate-200'}`}
                        />
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* ??Í∑†Ìòï??Î∞??§Ìä∏?àÏä§ */}
            <div className="space-y-8">
              <div className="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6">
                <div className="flex items-center gap-2 border-b border-slate-100 pb-4">
                  <div className="w-2 h-6 bg-red-500 rounded-full"></div>
                  <h3 className="font-bold text-slate-800 text-xl">??Í∑†Ìòï Î∞??§Ìä∏?àÏä§</h3>
                </div>

                <div className="space-y-6">
                  <div className="p-5 bg-slate-50 rounded-2xl border border-slate-200">
                    <label className="block text-sm font-bold text-slate-700 mb-4">??Í∑†Ìòï??%)</label>
                    <div className="flex items-center gap-6">
                      <div className="flex-1 space-y-2">
                        <p className="text-[10px] font-bold text-slate-400 text-center uppercase">Left (Ï¢åÏ∏°)</p>
                        <input type="number" step="0.1" value={hrv.brainBalanceL} onChange={e => setHrv({ ...hrv, brainBalanceL: Number(e.target.value), brainBalanceR: Number((100 - Number(e.target.value)).toFixed(1)) })} className="w-full p-3 bg-white border rounded-xl text-center font-bold" />
                      </div>
                      <div className="text-slate-300 font-bold">:</div>
                      <div className="flex-1 space-y-2">
                        <p className="text-[10px] font-bold text-slate-400 text-center uppercase">Right (?∞Ï∏°)</p>
                        <input type="number" step="0.1" value={hrv.brainBalanceR} onChange={e => setHrv({ ...hrv, brainBalanceR: Number(e.target.value), brainBalanceL: Number((100 - Number(e.target.value)).toFixed(1)) })} className="w-full p-3 bg-white border rounded-xl text-center font-bold" />
                      </div>
                    </div>
                  </div>

                  <div className="space-y-3">
                    <label className="block text-sm font-bold text-slate-700">?êÎáå ?§Ìä∏?àÏä§</label>
                    <div className="grid grid-cols-4 gap-2">
                      {['??ùå', 'Î≥¥ÌÜµ', 'Ï§ëÍ∞Ñ', '?íÏùå'].map(cat => (
                        <button
                          key={cat}
                          onClick={() => setHrv({ ...hrv, brainStressCategory: cat })}
                          className={`py-3 rounded-xl text-xs font-bold border transition-all ${hrv.brainStressCategory === cat ? 'bg-red-500 text-white border-red-500' : 'bg-white text-slate-400 border-slate-200'}`}
                        >
                          {cat}
                        </button>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <div className="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6">
                <div className="flex items-center gap-2 border-b border-slate-100 pb-4">
                  <div className="w-2 h-6 bg-amber-500 rounded-full"></div>
                  <h3 className="font-bold text-slate-800 text-xl">?∏Ï? Í∏∞Îä• ?âÍ?</h3>
                </div>

                <div className="space-y-6">
                  <div className="space-y-4">
                    <div className="flex justify-between items-center"><label className="text-sm font-bold text-slate-700">ÏßëÏ§ë??Concentration)</label></div>
                    <div className="flex gap-4">
                      <input type="number" placeholder="Lv" value={hrv.concentrationLevel} onChange={e => setHrv({ ...hrv, concentrationLevel: Number(e.target.value) })} className="w-20 p-3 bg-slate-50 border border-slate-200 rounded-xl text-center font-bold" />
                      <div className="flex-1 grid grid-cols-3 gap-1">
                        {['??ùå', 'Ï§ëÍ∞Ñ', '?íÏùå'].map(cat => (
                          <button key={cat} onClick={() => setHrv({ ...hrv, concentrationCategory: cat })} className={`rounded-lg text-[10px] font-bold border transition-all ${hrv.concentrationCategory === cat ? 'bg-amber-500 text-white border-amber-500' : 'bg-white text-slate-400 border-slate-200'}`}>{cat}</button>
                        ))}
                      </div>
                    </div>
                  </div>

                  <div className="space-y-4">
                    <div className="flex justify-between items-center"><label className="text-sm font-bold text-slate-700">Ï£ºÏùò??Attention)</label></div>
                    <div className="flex gap-4">
                      <input type="number" placeholder="Lv" value={hrv.attentionLevel} onChange={e => setHrv({ ...hrv, attentionLevel: Number(e.target.value) })} className="w-20 p-3 bg-slate-50 border border-slate-200 rounded-xl text-center font-bold" />
                      <div className="flex-1 grid grid-cols-3 gap-1">
                        {['??ùå', 'Ï§ëÍ∞Ñ', '?íÏùå'].map(cat => (
                          <button key={cat} onClick={() => setHrv({ ...hrv, attentionCategory: cat })} className={`rounded-lg text-[10px] font-bold border transition-all ${hrv.attentionCategory === cat ? 'bg-blue-600 text-white border-blue-600' : 'bg-white text-slate-400 border-slate-200'}`}>{cat}</button>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div className="flex gap-4">
            <button onClick={() => setStep('hrv')} className="flex-1 py-4 bg-white border border-slate-200 text-slate-600 font-bold rounded-2xl hover:bg-slate-50 transition-all">Back</button>
            <button onClick={handleFinalAssessment} className="flex-[2] py-4 bg-slate-900 text-white font-bold rounded-2xl shadow-lg hover:bg-slate-800 transition-all">Generate Integrated Report</button>
          </div>
        </div>
      </Layout>
    );
  }

  if (step === 'loading') {
    return (
      <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu} isDarkMode={isDarkMode} onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}>
        <div className="flex flex-col items-center justify-center min-h-[60vh]">
          <div className="w-16 h-16 border-4 border-blue-100 border-t-blue-600 rounded-full animate-spin mb-6"></div>
          <h2 className="text-2xl font-bold text-slate-800">?µÌï© ?∞Ïù¥??Î∂ÑÏÑù Ï§?..</h2>
          <p className="text-slate-500 mt-2">?†Ìòï ?ùÎ≥Ñ Î∞??ÅÏñë ?îÎ£®?òÏùÑ ?ùÏÑ±?òÍ≥† ?àÏäµ?àÎã§.</p>
        </div>
      </Layout>
    );
  }

  if (step === 'results' && result) {
    // Helper to select products based on CareType & Biometrics
    // PNT Mall ?ÅÏÑ∏ Í∏∞Îä• Î¶¨ÏÑúÏπ?Í∏∞Î∞ò Ï∂îÏ≤ú Î°úÏßÅ (2024-12-30 Updated)
    const getRecommendedProducts = () => {
      const productIds = new Set<string>();

      // Base: Î™®Îì† ?ÔøΩÌóò?ÔøΩÏóêÔø?Î©¥Ïó≠ Í¥ÄÎ¶¨Îäî ?ÔøΩÏàò (?ÔøΩÍ≤ΩÔø??ÔøΩÏó∞/ÎπÑÔøΩ?ÎØºB)
      productIds.add('immune_one');

      // 1. [Ôø??ÔøΩÎ¶Ω] ?ÔøΩÎ©¥ ?ÔøΩÏú® & ?ÔøΩÎ©¥ ?ÔøΩÏï†
      // ISI(Î∂àÎ©¥Ôø?Ï≤ôÎèÑ) 10???ÔøΩÏÉÅ?ÔøΩÍ±∞?? Î∂ÄÍµêÍ∞ê?ÔøΩÍ≤Ω ?ÔøΩÏÑ±?ÔøΩÔøΩ? ?ÔøΩÎ¨¥ ??ÔøΩÔøΩ(?ÔøΩÏôÑ Î∂àÔøΩ?) ?ÔøΩÎ©¥ ÏßÑÏûÖ???ÔøΩÎ†§??Í≤ΩÏö∞
      if (result.survey.isi >= 10 || result.hrv.pns < 20) {
        productIds.add('calm_sleep');
      }

      // 2. [?ÔøΩÏù¥?ÔøΩÏóÖ] ?ÔøΩÌä∏?ÔøΩÏä§???ÔøΩÎ°ú & ÏßÄÍµ¨Î†• (?ÔøΩÍ≤ΩÔø?
      // ÎßåÏÑ± ?ÔøΩÎ°úÔø??ÔøΩÏÜå?ÔøΩÍ±∞?? Î¨¥Í∏∞?ÔøΩÌòï(Motivation Low corresponds to Poor Circulation in legacy logic)??Í≤ΩÏö∞
      if (result.careType === CareType.CIRCULATION || result.survey.fatigueSymptomsCount >= 3 || result.survey.chronicFatigue) {
        productIds.add('ad_up');
      }

      // 3. [?ÔøΩÎÑàÏßÄ Î∞∏Îü∞?? Í≥ºÎèÑ??Í∏¥Ïû• ?ÔøΩÏ†ú (?ÔøΩÏïÑ??
      // ÍµêÍ∞ê?ÔøΩÍ≤Ω(SNS) ??ÔøΩÔøΩ(65+), Î∂àÏïà??Anxiety), ?ÔøΩÎäî BAI ?ÔøΩÏàòÍ∞Ä ?ÔøΩÔøΩ? Í≤ΩÏö∞ -> Í∏¥Ïû• ?ÔøΩÌôî ?ÔøΩÏöî
      if (result.hrv.sns > 65 || result.careType === CareType.BURNOUT || result.survey.bai >= 15) {
        productIds.add('energy_bal');
      }

      // 4. [?îÏò§Ïπ¥Îîî] ?êÎáå ?∏Ï???& Í∏∞Ïñµ???¨Ïä§?åÌã∞?úÏÑ∏Î¶?
      // ÏßëÏ§ë??Í≤∞Ìïç, ???ºÎ°úÍ∞Ä ?íÏùå, ?êÎäî ?úÏúÑÎ•??ΩÍ∞Ñ ?ÑÌïú 'ÏßëÏ§ë?? Í¥Ä??
      if (result.careType === CareType.CONCENTRATION || result.hrv.brainScore < 75 || result.survey.concentrationScore < 12) {
        productIds.add('no_cardi');
      }

      // 5. [ÎßàÍ∑∏?§Ïäò] ?†Í≤Ω/Í∑ºÏú° ?àÏ†ï
      // ?†Ï≤¥??Ï¶ùÏÉÅ(?àÎñ®Î¶????¥Í±∞???åÌååÍ∞Ä High-Beta(Í∏¥Ïû•) ?∞ÏÑ∏????
      if (result.hrv.dominantEEG === 'H-Beta' || result.hrv.stressResistance < 40) {
        productIds.add('magnesium');
      }

      return Array.from(productIds).map(id => PRODUCTS[id]).filter(Boolean);
    };

    return (
      <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu} isDarkMode={isDarkMode} onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}>
        {/* Config Modal with Tabs */}
        {showConfig && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
            <div className="bg-white rounded-2xl w-full max-w-2xl overflow-hidden shadow-2xl max-h-[90vh] flex flex-col">
              <div className="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                <div className="flex gap-4">
                  <button onClick={() => setActiveConfigTab('general')} className={`text-sm font-bold pb-1 border-b-2 transition-colors ${activeConfigTab === 'general' ? 'border-slate-800 text-slate-800' : 'border-transparent text-slate-400'}`}>General</button>
                  <button onClick={() => setActiveConfigTab('strategy')} className={`text-sm font-bold pb-1 border-b-2 transition-colors ${activeConfigTab === 'strategy' ? 'border-slate-800 text-slate-800' : 'border-transparent text-slate-400'}`}>Type Strategy</button>
                  {isAdminUnlocked && (
                    <button onClick={() => setActiveConfigTab('subject')} className={`text-sm font-bold pb-1 border-b-2 transition-colors ${activeConfigTab === 'subject' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-400'}`}>Subject Strategy</button>
                  )}
                </div>
                <button onClick={() => setShowConfig(false)} className="text-slate-400 hover:text-slate-600">??/button>
              </div>

              <div className="p-6 overflow-y-auto custom-scrollbar">
                {activeConfigTab === 'general' ? (
                  <div className="space-y-4">
                    <label className="flex items-center justify-between p-4 border rounded-xl cursor-pointer hover:bg-slate-50">
                      <div className="space-y-1">
                        <p className="font-bold text-slate-900">?òÌóò???ÑÏö© Î™®Îìú (Exam Mode)</p>
                        <p className="text-xs text-slate-500">Î¶¨Ìè¨?∏Ïóê ?òÌóò ?ÑÎûµ Î∞??òÌóò??ÏΩîÎ©ò???¨Ìï®</p>
                      </div>
                      <input type="checkbox" checked={config.isExamMode} onChange={e => setConfig({ ...config, isExamMode: e.target.checked })} className="toggle accent-blue-600 w-5 h-5" />
                    </label>
                    <label className="flex items-center justify-between p-4 border rounded-xl cursor-pointer hover:bg-slate-50">
                      <div className="space-y-1">
                        <p className="font-bold text-slate-900">?ÅÏÑ∏ ?§Î™Ö Î™®Îìú (Verbose)</p>
                        <p className="text-xs text-slate-500">Î∂ÑÏÑù ?çÏä§??Í∏∏Ïù¥ Î∞??ÑÎ¨∏ ?©Ïñ¥ ?§Î™Ö Í∞ïÌôî</p>
                      </div>
                      <input type="checkbox" checked={config.showDetail} onChange={e => setConfig({ ...config, showDetail: e.target.checked })} className="toggle accent-blue-600 w-5 h-5" />
                    </label>
                  </div>
                ) : activeConfigTab === 'subject' ? (
                  <div className="space-y-6 animate-in fade-in duration-300">
                    <div className="bg-indigo-50 p-4 rounded-xl text-indigo-900 text-sm mb-4">
                      <strong>Í¥ÄÎ¶¨Ïûê Î™®Îìú (Admin)</strong>: ?ôÏÉù?êÍ≤å ?ÅÏö©??Í≥ºÎ™©Î≥??ôÏäµ ?ÑÎûµ??Ï≤¥ÌÅ¨?òÏã≠?úÏò§.
                    </div>
                    {(['korean', 'math', 'english'] as const).map(subj => {
                      const options = SUBJECT_OPTIONS_MAP[subj] || [];
                      // Group by category
                      const categories = Array.from(new Set(options.map(o => o.category)));

                      return (
                        <div key={subj} className="border-b border-slate-100 pb-6 mb-6 last:border-0 last:mb-0">
                          <h4 className="font-bold text-slate-800 text-lg mb-4 flex items-center gap-2">
                            <span className="w-2 h-8 bg-indigo-500 rounded-full"></span>
                            {subj === 'korean' ? 'Íµ?ñ¥ (Korean)' : subj === 'math' ? '?òÌïô (Math)' : '?ÅÏñ¥ (English)'}
                          </h4>
                          <div className="space-y-6">
                            {categories.map(cat => (
                              <div key={cat}>
                                <h5 className="text-xs font-bold text-slate-400 uppercase mb-3">{cat}</h5>
                                <div className="space-y-3">
                                  {options.filter(o => o.category === cat).map(option => (
                                    <label key={option.id} className="flex items-start gap-3 p-3 rounded-lg hover:bg-slate-50 cursor-pointer border border-transparent hover:border-slate-200 transition-all">
                                      <input
                                        type="checkbox"
                                        className="mt-1 w-5 h-5 accent-indigo-600"
                                        checked={selectedSubjectOptions[subj]?.includes(option.id)}
                                        onChange={e => {
                                          const current = selectedSubjectOptions[subj] || [];
                                          const next = e.target.checked
                                            ? [...current, option.id]
                                            : current.filter(id => id !== option.id);
                                          setSelectedSubjectOptions({ ...selectedSubjectOptions, [subj]: next });
                                        }}
                                      />
                                      <div>
                                        <p className="font-bold text-slate-800 text-sm">{option.title}</p>
                                        <p className="text-xs text-slate-500 mt-0.5">{option.content}</p>
                                      </div>
                                    </label>
                                  ))}
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  <div className="space-y-6">
                    <div className="flex items-center gap-2">
                      <label className="text-sm font-bold text-slate-500">CareType:</label>
                      <select
                        value={editingStrategyType}
                        onChange={(e) => setEditingStrategyType(e.target.value as CareType)}
                        className="p-2 border rounded-lg text-sm font-bold text-slate-800 bg-white"
                      >
                        {Object.values(CareType).map(t => <option key={t} value={t}>{t}</option>)}
                      </select>
                    </div>
                    <div className="space-y-4">
                      <div>
                        <label className="text-xs font-bold text-slate-500 uppercase block mb-1">Nutrition Guide</label>
                        <textarea
                          className="w-full h-24 p-3 text-sm border rounded-xl bg-slate-50 focus:bg-white focus:ring-2 ring-blue-100 outline-none resize-none"
                          value={strategies[editingStrategyType].nutritionGuide}
                          onChange={e => setStrategies({
                            ...strategies,
                            [editingStrategyType]: { ...strategies[editingStrategyType], nutritionGuide: e.target.value }
                          })}
                        />
                      </div>
                      <div>
                        <label className="text-xs font-bold text-slate-500 uppercase block mb-1">Study Strategy</label>
                        <textarea
                          className="w-full h-24 p-3 text-sm border rounded-xl bg-slate-50 focus:bg-white focus:ring-2 ring-blue-100 outline-none resize-none"
                          value={strategies[editingStrategyType].studyStrategy}
                          onChange={e => setStrategies({
                            ...strategies,
                            [editingStrategyType]: { ...strategies[editingStrategyType], studyStrategy: e.target.value }
                          })}
                        />
                      </div>
                      <div>
                        <label className="text-xs font-bold text-slate-500 uppercase block mb-1">Exercise Guide</label>
                        <textarea
                          className="w-full h-24 p-3 text-sm border rounded-xl bg-slate-50 focus:bg-white focus:ring-2 ring-blue-100 outline-none resize-none"
                          value={strategies[editingStrategyType].exerciseGuide}
                          onChange={e => setStrategies({
                            ...strategies,
                            [editingStrategyType]: { ...strategies[editingStrategyType], exerciseGuide: e.target.value }
                          })}
                        />
                      </div>
                      <div>
                        <label className="text-xs font-bold text-slate-500 uppercase block mb-1">Pre-Study Routine</label>
                        <textarea
                          className="w-full h-24 p-3 text-sm border rounded-xl bg-slate-50 focus:bg-white focus:ring-2 ring-blue-100 outline-none resize-none"
                          value={strategies[editingStrategyType].preStudyRoutine}
                          onChange={e => setStrategies({
                            ...strategies,
                            [editingStrategyType]: { ...strategies[editingStrategyType], preStudyRoutine: e.target.value }
                          })}
                        />
                      </div>
                    </div>
                  </div>
                )}
              </div>
              <div className="p-4 border-t border-slate-100 bg-slate-50">
                <button onClick={() => setShowConfig(false)} className="w-full py-3 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition">Close & Apply</button>
              </div>
            </div>
          </div>
        )}

        {/* Admin Password Modal */}
        {showAdminPassword && (
          <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 animate-in fade-in duration-200">
            <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-xs">
              <h3 className="font-bold text-lg mb-4 text-slate-800">Admin Access Required</h3>
              <input
                type="password"
                className="w-full p-3 border rounded-xl mb-4 focus:ring-2 focus:ring-indigo-500 outline-none"
                placeholder="Enter Password"
                value={adminPasswordInput}
                onChange={e => setAdminPasswordInput(e.target.value)}
