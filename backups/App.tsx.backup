                      {g === 'Male' ? '?®ÏÑ±' : '?¨ÏÑ±'}
                    </button>
                  ))}
                </div>
              </div>

              <div className="space-y-2 md:col-span-2">
                <label className="text-sm font-bold text-slate-700">Í∞Ä??Î∂Ä?¥Îêò??Í≥ºÎ™© (Focus Subject)</label>
                <div className="grid grid-cols-3 gap-4">
                  {(['korean', 'math', 'english'] as const).map(subj => (
                    <button
                      key={subj}
