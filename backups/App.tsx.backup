                </div>
              </div>
            </div>
            <button onClick={() => setStep('surveys')} disabled={!student.name} className="w-full py-4 bg-blue-600 text-white font-bold rounded-2xl shadow-lg hover:bg-blue-700 disabled:opacity-50 transition-all mt-4">Í≤Ä???úÏûë (Start Assessment)</button>
          </div>
        </div>
      </Layout>
    );
  }

  if (step === 'surveys') {
    return (
