type SurveyTab = 'ans' | 'bai' | 'isi' | 'concentration' | 'cfs';

const App: React.FC = () => {
  const [step, setStep] = useState<'register' | 'surveys' | 'protocol' | 'analytics' | 'hrv' | 'eeg' | 'loading' | 'results'>('register');
  const [activeMenu, setActiveMenu] = useState<'dashboard' | 'assessment' | 'history' | 'progress' | 'resources'>('dashboard');
  const [activeTab, setActiveTab] = useState<SurveyTab>('ans');
  const [student, setStudent] = useState<StudentInfo>(initialStudent);
  const [hrv, setHrv] = useState<HRVData>(initialHRV);
  const [protocol, setProtocol] = useState<ProtocolData>(initialProtocol);
  const [analytics, setAnalytics] = useState<LearningAnalyticsData>(initialAnalytics);
  const [isCustomLoc, setIsCustomLoc] = useState(false);

  // Survey States
  const [snsSymptomSelection, setSnsSymptomSelection] = useState<string[]>([]);
  const [pnsSymptomSelection, setPnsSymptomSelection] = useState<string[]>([]);
  const [baiAnswers, setBaiAnswers] = useState<number[]>(new Array(21).fill(0));
  const [isiAnswers, setIsiAnswers] = useState<number[]>(new Array(7).fill(0));
  const [concentrationAnswers, setConcentrationAnswers] = useState<number[]>(new Array(7).fill(0));
  const [fatigueCore, setFatigueCore] = useState<boolean>(false);
  const [fatigueSymptoms, setFatigueSymptoms] = useState<boolean[]>(new Array(8).fill(false));

  // BAI specific sub-tab state
  const [baiSubPage, setBaiSubPage] = useState<1 | 2>(1);


  const [result, setResult] = useState<AssessmentResult | null>(null);

  // Configuration State
  const [showConfig, setShowConfig] = useState(false);
  const [config, setConfig] = useState({
    isExamMode: true,
    showDetail: true
  });

  // Strategy State needed for customization
  const [strategies, setStrategies] = useState<StrategyMap>(DEFAULT_STRATEGIES);

  // Í≥ºÎ™©Ôø??ÔøΩÎûµ ?ÔøΩÌÉù State (Checkbox IDs)
  const [selectedSubjectOptions, setSelectedSubjectOptions] = useState<Record<string, string[]>>({
    korean: ['kor_1'],
    math: ['math_psy_1', 'math_phy_1', 'math_routine_1'],
    english: ['eng_1']
  });

  // Student Checklist State (?ÔøΩÏÉù???ÔøΩÏ≤ú ?ÔøΩÔøΩ? Ï≤¥ÌÅ¨)
  const [completedItems, setCompletedItems] = useState<string[]>([]);

  // History State
  const [history, setHistory] = useState<(AssessmentResult & { date: string })[]>([]);

  const [activeConfigTab, setActiveConfigTab] = useState<'general' | 'strategy' | 'subject'>('general');
  const [editingStrategyType, setEditingStrategyType] = useState<CareType>(CareType.BURNOUT);

  // Dark Mode State
  const [isDarkMode, setIsDarkMode] = useState(() => {
    const saved = localStorage.getItem('darkMode');
    if (saved !== null) return saved === 'true';
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  });

  // Apply Dark Mode
  useEffect(() => {
    if (isDarkMode) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
    localStorage.setItem('darkMode', isDarkMode.toString());
  }, [isDarkMode]);

  // Load History on Mount
  useEffect(() => {
    const saved = localStorage.getItem('sn1_history');
    if (saved) {
      try {
        const parsed = JSON.parse(saved);
        // Validate that the data has the new format (AssessmentResult with date)
        if (Array.isArray(parsed) && parsed.length > 0) {
          // Check if first item has the new format (has student, careType, etc.)
          const firstItem = parsed[0];
          if (firstItem && typeof firstItem === 'object' && 'student' in firstItem && 'careType' in firstItem) {
            setHistory(parsed);
          } else {
            // Old format detected, clear it
            console.log('Old history format detected, clearing...');
            localStorage.removeItem('sn1_history');
            setHistory([]);
          }
        }
      } catch (e) {
        console.error('Failed to parse history', e);
        localStorage.removeItem('sn1_history');
        setHistory([]);
      }
    }
  }, []);

  // Save Result to History when result is generated
  useEffect(() => {
    if (step === 'results' && result) {
      const newEntry = {
        ...result,
        date: new Date().toISOString()
      };

      setHistory(prev => {
        // Prevent duplicate save if last entry is same type/score and very recent (e.g. within 1 min)
        if (prev.length > 0) {
          const last = prev[0];
          if (last.careType === newEntry.careType && last.score === newEntry.score &&
            new Date().getTime() - new Date(last.date).getTime() < 60000) {
            return prev;
          }
        }
        const updated = [newEntry, ...prev].slice(0, 10); // Keep last 10
        localStorage.setItem('sn1_history', JSON.stringify(updated));
        return updated;
      });
    }
  }, [step, result]);

  const toggleCompleted = (id: string) => {
    setCompletedItems(prev =>
      prev.includes(id) ? prev.filter(i => i !== id) : [...prev, id]
    );
  };

  // Hidden Admin Menu State
  const [showAdminPassword, setShowAdminPassword] = useState(false);
  const [adminPasswordInput, setAdminPasswordInput] = useState('');
  const [isAdminUnlocked, setIsAdminUnlocked] = useState(false);

  const handleAdminUnlock = () => {
    if (adminPasswordInput === '3123') {
      setIsAdminUnlocked(true);
      setShowAdminPassword(false);
      setShowConfig(true);
      setActiveConfigTab('subject'); // Î∞îÎ°ú Í≥ºÎ™© ?ÔøΩÏ†ï ??ÔøΩÔøΩÔø??ÔøΩÎèô
    } else {
      alert('Password Incorrect');
    }
  };

  useEffect(() => {
    setStudent(prev => ({ ...prev, age: calculateAge(prev.birthDate) }));
  }, [student.birthDate]);

  const calculateAge = (birthDate: string) => {
    if (!birthDate) return 0;
    const today = new Date();
    const birth = new Date(birthDate);
    let age = today.getFullYear() - birth.getFullYear();
    const m = today.getMonth() - birth.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) {
      age--;
    }
    return age;
  }

  const handleBirthDateChange = (date: string) => {
    setStudent(prev => ({
      ...prev,
      birthDate: date,
      age: calculateAge(date)
    }));
  };

  const surveyScores = useMemo(() => {
    const bai = baiAnswers.reduce((a, b) => a + b, 0);
    const isi = isiAnswers.reduce((a, b) => a + b, 0);
    const concentration = concentrationAnswers.reduce((a, b) => a + b, 0);
    const fatigueCount = fatigueSymptoms.filter(s => s).length;
    const snsCount = snsSymptomSelection.length;
    const pnsCount = pnsSymptomSelection.length;
    return { bai, isi, concentration, fatigueCount, snsCount, pnsCount, isChronicFatigue: fatigueCore && fatigueCount >= 4 };
  }, [baiAnswers, isiAnswers, concentrationAnswers, fatigueCore, fatigueSymptoms, snsSymptomSelection, pnsSymptomSelection]);

  const baiEvaluation = useMemo(() => {
    const score = surveyScores.bai;
    if (score <= 9) return { text: "?ïÏÉÅ??Î≤îÏúÑ", color: "text-emerald-600" };
    if (score <= 18) return { text: "Í≤ΩÎ????òÏ???Î∂àÏïà", color: "text-blue-600" };
    if (score <= 29) return { text: "?ÅÎãπ???òÏ???Î∂àÏïà (Í¥Ä???ÑÏöî)", color: "text-orange-600" };
    return { text: "?¨Ìïú ?òÏ???Î∂àÏïà (?ÑÎ¨∏Í∞Ä ?ÅÎã¥ Í∂åÍ≥†)", color: "text-red-600" };
  }, [surveyScores.bai]);

  const isiEvaluation = useMemo(() => {
    const score = surveyScores.isi;
    if (score <= 7) return { text: "?òÎ??àÎäî ÎßåÌÅº??Î∂àÎ©¥Ï¶ùÏù¥ ?ÜÏäµ?àÎã§.", color: "text-emerald-600" };
    if (score <= 14) return { text: "?ΩÍ∞Ñ??Î∂àÎ©¥Í≤ΩÌñ•???àÏäµ?àÎã§.", color: "text-blue-600" };
    if (score <= 21) return { text: "Ï§ëÏ¶ù?ÑÏùò Î∂àÎ©¥Ï¶ùÏù¥ ?àÏäµ?àÎã§.", color: "text-orange-600" };
    return { text: "?¨Ìïú Î∂àÎ©¥Ï¶ùÏù¥ ?àÏäµ?àÎã§.", color: "text-red-600" };
  }, [surveyScores.isi]);

  const handleFinalAssessment = async () => {
    setStep('loading');

    const surveyData: SurveyData = {
      gad7: 5,
      bai: surveyScores.bai,
      isi: surveyScores.isi,
      concentrationScore: surveyScores.concentration,
      chronicFatigue: surveyScores.isChronicFatigue,
      fatigueSymptomsCount: surveyScores.fatigueCount,
      symptoms: FATIGUE_SYMPTOMS.filter((_, i) => fatigueSymptoms[i]),
      sympatheticSymptoms: snsSymptomSelection,
      parasympatheticSymptoms: pnsSymptomSelection
    };

    // UXÎ•??ÑÌïú ?∏ÏúÑ?ÅÏù∏ ?úÎ†à??Î∂ÑÏÑù Ï§??êÎÇå)
    await new Promise(resolve => setTimeout(resolve, 1500));


    const type = CLASSIFY_STUDENT(hrv, surveyData);
    // NEW: Logic Engine Analysis with Config
    const analysis = generateClinicalAnalysis(hrv, surveyData, protocol, analytics, type, config.isExamMode);

    setResult({
      student,
      careType: type,
      hrv,
      survey: surveyData,
      protocol,
      analytics,
      nutrition: SOLUTIONS[type].nutrition,
      careGuide: SOLUTIONS[type].care,
      analysisText: analysis,
      score: surveyScores.bai // Using BAI score as a representative score for history
    });
    setStep('results');
  };

  // --- Menu Views ---
  if (activeMenu === 'dashboard') {
    return <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu} isDarkMode={isDarkMode} onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}><DashboardView onStartClick={() => { setActiveMenu('assessment'); setStep('register'); }} onHistoryClick={() => setActiveMenu('history')} onResourcesClick={() => setActiveMenu('resources')} history={history} /></Layout>;
  }
  if (activeMenu === 'history') {
    const handleViewDetail = (record: AssessmentResult) => {
      setResult(record);
      setStep('results');
      setActiveMenu('assessment');
    };

    const handleImportData = (data: (AssessmentResult & { date: string })[], merge: boolean) => {
      if (merge) {
        // Î≥ëÌï©: Ï§ëÎ≥µ ?úÍ±∞ (?†Ïßú Í∏∞Ï?)
        const existingDates = new Set(history.map(h => h.date));
        const newData = data.filter(d => !existingDates.has(d.date));
        const merged = [...history, ...newData].sort((a, b) =>
          new Date(b.date).getTime() - new Date(a.date).getTime()
        ).slice(0, 50); // ÏµúÎ? 50Í∞??†Ï?
        setHistory(merged);
        localStorage.setItem('sn1_history', JSON.stringify(merged));
      } else {
        // ??ñ¥?∞Í∏∞
        setHistory(data);
        localStorage.setItem('sn1_history', JSON.stringify(data));
      }
    };

    const handleExportJSON = () => {
      const jsonStr = JSON.stringify(history, null, 2);
      const blob = new Blob([jsonStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `mind-body-history-${new Date().toISOString().split('T')[0]}.json`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    };

    const handleExportCSV = () => {
      if (history.length === 0) {
        alert('?¥Î≥¥???∞Ïù¥?∞Í? ?ÜÏäµ?àÎã§.');
        return;
      }

      const headers = ['?†Ïßú', '?¥Î¶Ñ', '?òÏù¥', '?±Î≥Ñ', 'ÏßÑÎã® ?†Ìòï', '?êÏàò', 'BAI', 'ISI', 'ÏßëÏ§ë??, 'Brain Score', 'SNS', 'PNS', '?ºÎ°ú??, '?úÎ†•??];
      const rows = history.map(record => [
        new Date(record.date).toLocaleString('ko-KR'),
        record.student.name,
        record.student.age,
        record.student.gender === 'Male' ? '?®ÏÑ±' : '?¨ÏÑ±',
        record.careType,
        record.score,
        record.survey.bai,
        record.survey.isi,
        record.survey.concentrationScore,
        record.hrv.brainScore,
        record.hrv.sns,
        record.hrv.pns,
        record.hrv.fatigue,
        record.hrv.vitality
      ]);

      const csvContent = [
        headers.join(','),
        ...rows.map(row => row.map(cell => `"${cell}"`).join(','))
      ].join('\n');

      const blob = new Blob(['\uFEFF' + csvContent], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `mind-body-history-${new Date().toISOString().split('T')[0]}.csv`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    };

    return (
      <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu} isDarkMode={isDarkMode} onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}>
        <HistoryView
          history={history}
          onStartClick={() => { setActiveMenu('assessment'); setStep('register'); }}
          onViewDetail={handleViewDetail}
          onImportData={handleImportData}
          onExportJSON={handleExportJSON}
          onExportCSV={handleExportCSV}
        />
      </Layout>
    );
  }
  if (activeMenu === 'progress') {
    return <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu} isDarkMode={isDarkMode} onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}><ProgressView history={history} onStartClick={() => { setActiveMenu('assessment'); setStep('register'); }} /></Layout>;
  }
  if (activeMenu === 'resources') {
    return <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu} isDarkMode={isDarkMode} onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}><ResourcesView /></Layout>;
  }
  // ------------------

  const toggleSnsSymptom = (s: string) => {
    setSnsSymptomSelection(prev => prev.includes(s) ? prev.filter(i => i !== s) : [...prev, s]);
  };

  const togglePnsSymptom = (s: string) => {
    setPnsSymptomSelection(prev => prev.includes(s) ? prev.filter(i => i !== s) : [...prev, s]);
  };

  if (step === 'register') {
    return (
      <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu} isDarkMode={isDarkMode} onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}>
        <div className="max-w-2xl mx-auto bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-500">
          <div className="bg-blue-600 p-8 text-white">
            <h2 className="text-2xl font-bold">Student Registration</h2>
            <p className="text-blue-100 mt-1">Í∏∞Î≥∏ ?ïÎ≥¥Î•??ÖÎ†•?òÏó¨ ÏßÑÎã®???úÏûë?òÏã≠?úÏò§.</p>
          </div>
          <div className="p-8 space-y-6">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">Serial ID (?êÎèô ?ùÏÑ±)</label>
                <div className="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-slate-500 font-mono text-sm">{student.id}</div>
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">Í≤Ä???ºÏûê (Test Date)</label>
                <input type="date" value={student.testDate} onChange={e => setStudent({ ...student, testDate: e.target.value })} className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all" />
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">?¥Î¶Ñ (Full Name)</label>
                <input type="text" placeholder="?¥Î¶Ñ???ÖÎ†•?òÏÑ∏?? value={student.name} onChange={e => setStudent({ ...student, name: e.target.value })} className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all" />
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">?ôÎÖÑ (Grade)</label>
                <select value={student.grade} onChange={e => setStudent({ ...student, grade: e.target.value })} className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all">
