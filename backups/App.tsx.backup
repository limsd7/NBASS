                      ))}
                    </tbody>
                  </table>

                  <div className="mt-8 pt-6 border-t border-slate-100 flex justify-end items-center gap-6">
                    <span className="text-sm font-bold text-slate-400">?ôÏäµ ÏßëÏ§ë??ÏßÄ??Concentration Score)</span>
                    <div className="text-3xl font-black text-amber-600">{surveyScores.concentration} <span className="text-base font-bold text-slate-300">/ 28</span></div>
                  </div>
                </div>
              </div>
            )}

            {activeTab === 'cfs' && (
              <div className="bg-white rounded-3xl border border-slate-200 p-8 space-y-6 shadow-sm">
                <div className="bg-emerald-50 p-4 rounded-xl border border-emerald-100">
                  <p className="text-sm font-bold text-emerald-800">Are you experiencing chronic fatigue ({'>'}6 months)?</p>
                  <div className="flex gap-4 mt-2">
                    <button onClick={() => setFatigueCore(true)} className={`px-6 py-2 rounded-lg font-bold transition-all ${fatigueCore ? 'bg-emerald-600 text-white shadow-sm' : 'bg-white border border-emerald-200 text-emerald-600'}`}>Yes</button>
                    <button onClick={() => setFatigueCore(false)} className={`px-6 py-2 rounded-lg font-bold transition-all ${!fatigueCore ? 'bg-slate-600 text-white shadow-sm' : 'bg-white border border-slate-200 text-slate-600'}`}>No</button>
                  </div>
                </div>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                  {FATIGUE_SYMPTOMS.map((s, i) => (
                    <label key={i} className={`p-4 rounded-xl border cursor-pointer transition-all ${fatigueSymptoms[i] ? 'bg-emerald-50 border-emerald-500 shadow-sm' : 'bg-white border-slate-200'}`}>
                      <input type="checkbox" checked={fatigueSymptoms[i]} onChange={() => { const a = [...fatigueSymptoms]; a[i] = !a[i]; setFatigueSymptoms(a); }} className="mr-3" />
                      <span className="text-sm font-medium">{s}</span>
                    </label>
                  ))}
                </div>
              </div>
            )}
          </div>

          <div className="flex gap-4">
            {activeTab !== 'ans' && <button onClick={() => { const t: any[] = ['ans', 'bai', 'isi', 'concentration', 'cfs']; setActiveTab(t[t.indexOf(activeTab) - 1]); }} className="flex-1 py-4 bg-white border border-slate-200 rounded-2xl font-bold text-slate-600 hover:bg-slate-50 transition-all">Previous</button>}
            <button
              onClick={() => {
                if (activeTab === 'ans') setActiveTab('bai');
                else if (activeTab === 'bai') setActiveTab('isi');
                else if (activeTab === 'isi') setActiveTab('concentration');
                else if (activeTab === 'concentration') setActiveTab('cfs');
                else setStep('protocol');
              }}
              className="flex-[2] py-4 bg-slate-900 text-white font-bold rounded-2xl shadow-lg hover:bg-slate-800 transition-all"
            >
              {activeTab === 'cfs' ? 'Go to Learning Protocol' : 'Next Step'}
            </button>
          </div>
        </div>
      </Layout>
    );
  }

  if (step === 'protocol') {
    return (
      <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu} isDarkMode={isDarkMode} onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}>
        <div className="max-w-3xl mx-auto space-y-8 animate-in fade-in slide-in-from-right-4 duration-500 pb-20">
          <div className="text-center">
            <h2 className="text-3xl font-extrabold text-slate-900">?ôÏäµ ÏßëÏ§ë??Î∂ÑÏÑù ?ÑÎ°ú?†ÏΩú</h2>
            <p className="text-slate-500 mt-2">?®Ïàú ?§Î¨∏???òÏñ¥ Î≥∏Ïßà?ÅÏù∏ ÏßëÏ§ë???Ä???îÏù∏??Î∂ÑÏÑù?©Îãà??</p>
          </div>

          <div className="grid grid-cols-1 gap-8">
            <div className="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-8">
              <div className="flex items-center gap-3">
                <span className="w-8 h-8 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-sm">1</span>
                <h3 className="text-xl font-bold text-slate-800">?¨Ï†Ñ Ï§ÄÎπ?Setting the Baseline)</h3>
              </div>
              <div className="space-y-6">
                <div>
                  <label className="block text-sm font-bold text-slate-700 mb-3">Ï£ºÎ°ú Í≥µÎ??òÎäî ?•ÏÜå (Place)</label>
                  <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
                    {['?ôÍµê (School)', '?ôÏõê (Academy)', '?ÑÏÑúÍ¥Ä (Library)', 'Ïπ¥Ìéò (Cafe)', 'Ïß?Home)', '?ÖÏÑú??Study Room)', 'Í∏∞Ì?'].map(loc => (
                      <button
                        key={loc}
                        onClick={() => {
                          if (loc === 'Í∏∞Ì?') {
                            setIsCustomLoc(true);
                            setProtocol({ ...protocol, location: '' });
                          } else {
                            setIsCustomLoc(false);
                            setProtocol({ ...protocol, location: loc });
                          }
                        }}
                        className={`p-3 text-xs font-bold rounded-xl border transition-all ${(!isCustomLoc && protocol.location === loc) || (loc === 'Í∏∞Ì?' && isCustomLoc) ? 'bg-blue-600 text-white border-blue-600 shadow-md' : 'bg-slate-50 text-slate-600 border-slate-200'}`}
                      >
                        {loc}
                      </button>
                    ))}
                  </div>
                  {isCustomLoc && (
                    <input
                      type="text"
                      placeholder="Í≥µÎ??òÎäî ?•ÏÜåÎ•?ÏßÅÏ†ë ?ÖÎ†•?òÏÑ∏??
                      value={protocol.location}
                      onChange={e => setProtocol({ ...protocol, location: e.target.value })}
                      className="mt-4 w-full px-4 py-3 bg-white border border-blue-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all text-sm"
                      autoFocus
                    />
                  )}
                </div>
                <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <div className="space-y-3">
                    <div className="flex justify-between items-end">
                      <label className="text-sm font-bold text-slate-700">Ï£ºÎ? ?åÏùå ?òÏ? (Noise)</label>
                      <span className="text-blue-600 font-bold text-lg">{protocol.noiseLevel}<span className="text-slate-300 text-sm ml-0.5">/10</span></span>
                    </div>
                    <input type="range" min="1" max="10" step="1" value={protocol.noiseLevel} onChange={e => setProtocol({ ...protocol, noiseLevel: Number(e.target.value) })} className="w-full h-2 bg-slate-100 rounded-lg appearance-none cursor-pointer accent-blue-600" />
                    <div className="bg-blue-50/50 p-3 rounded-xl border border-blue-100/50 min-h-[48px] flex items-center">
                      <p className="text-[11px] font-bold text-blue-600 leading-snug">{getNoiseDescription(protocol.noiseLevel)}</p>
                    </div>
                  </div>
