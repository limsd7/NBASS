                  <div className="p-6 grid gap-2 bg-slate-50">
                    {PARASYMPATHETIC_SYMPTOMS.map(s => (
                      <label key={s} className={`flex items-center gap-3 p-3 rounded-xl border ${pnsSymptomSelection.includes(s) ? 'bg-blue-50 border-blue-500' : 'bg-white'}`}>
                        <input type="checkbox" checked={pnsSymptomSelection.includes(s)} onChange={() => togglePnsSymptom(s)} className="accent-blue-700" />
                        <span className="text-sm font-medium">{s}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {activeTab === 'bai' && (
              <div className="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
                <div className="p-6 border-b border-slate-100 flex gap-1">
                  {([1, 2] as const).map(p => (
                    <button key={p} onClick={() => setBaiSubPage(p)} className={`px-4 py-1.5 text-xs font-bold rounded-t-lg border-x border-t transition-all ${baiSubPage === p ? 'bg-white border-slate-200 -mb-[25px] z-10 text-slate-900' : 'bg-slate-50 border-transparent text-slate-400'}`}>?òÏù¥ÏßÄ{p === 2 ? '2' : ''}</button>
                  ))}
                </div>

                <div className="p-8 space-y-6">
                  <h2 className="text-2xl font-bold text-slate-800">Beck Î∂àÏïà Ï≤ôÎèÑ Beck Anxiety Inventory : BAI</h2>

                  <div className="p-4 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-600 leading-relaxed">
                    Í∞?Î¨∏Ïû•???êÏÑ∏???ΩÏñ¥Î≥¥ÏãúÍ≥??§Îäò???¨Ìï®?¥ÏÑú ÏßÄ???ºÏ£º???ôÏïà ?êÏã†???ÅÌÉúÎ•?Í∞Ä?????òÌ??∏Îã§Í≥??ùÍ∞Å?òÎäî Î≤àÌò∏Î•??úÏãú?òÏó¨ Ï£ºÏã≠?úÏò§. ?ëÎãµÎ∞©Ïãù?Ä ?§ÏùåÍ≥?Í∞ôÏäµ?àÎã§.
                  </div>

                  <table className="w-full text-left">
                    <thead>
                      <tr className="text-[11px] md:text-xs font-bold text-slate-500 uppercase">
                        <th className="pb-4 font-bold text-slate-900">ÏßàÎ¨∏ ?¥Ïö©</th>
                        {["?ÑÌ? ?êÎÅºÏßÄ ?äÏïò??0??", "Ï°∞Í∏à ?êÍºà??1??", "?ÅÎãπ???êÍºà??2??", "?¨ÌïòÍ≤??êÍºà??3??"].map((h, i) => (
                          <th key={i} className="pb-4 text-center px-2 w-20 leading-tight">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-100">
                      {BAI_QUESTIONS.map((q, idx) => {
                        const startIdx = baiSubPage === 1 ? 0 : 10;
                        const endIdx = baiSubPage === 1 ? 10 : 21;
                        if (idx < startIdx || idx >= endIdx) return null;

                        return (
                          <tr key={idx} className="hover:bg-slate-50 transition-colors">
                            <td className="py-4 pr-4 text-sm font-medium text-slate-700">
                              {idx + 1}. {q}
                            </td>
                            {[0, 1, 2, 3].map(score => (
                              <td key={score} className="py-4 text-center">
                                <div className="flex justify-center">
                                  <button
                                    onClick={() => { const a = [...baiAnswers]; a[idx] = score; setBaiAnswers(a); }}
                                    className={`w-6 h-6 rounded-md border-2 transition-all flex items-center justify-center ${baiAnswers[idx] === score ? 'bg-blue-600 border-blue-600 shadow-sm' : 'bg-white border-slate-200 hover:border-blue-200'}`}
                                  >
