              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">?òÏù¥ (Age)</label>
                <div className="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-slate-600 font-bold">{student.age} ??/div>
              </div>
              <div className="space-y-2 md:col-span-2">
                <label className="text-sm font-bold text-slate-700">?±Î≥Ñ (Gender)</label>
                <div className="flex gap-4">
                  {['Male', 'Female'].map((g) => (
                    <button
