                          ? 'bg-rose-600 text-white border-rose-600 shadow-lg scale-105'
                          : 'bg-white text-slate-500 border-slate-200 hover:border-rose-200'
                          }`}
                      >
                        <span className="text-lg">{item.emoji}</span>
                        <span className="text-[10px] font-bold mt-1">{item.label}</span>
                        <span className={`text-[8px] ${hrv.ppgLevel === item.level ? 'text-white/80' : 'text-slate-400'}`}>{item.status}</span>
                      </button>
                    ))}
                  </div>
                  {hrv.ppgLevel && (
                    <div className={`p-4 rounded-xl border ${hrv.ppgLevel <= 2 ? 'bg-emerald-50 border-emerald-200' :
                      hrv.ppgLevel <= 4 ? 'bg-yellow-50 border-yellow-200' :
                        'bg-rose-50 border-rose-200'
                      }`}>
                      <div className="flex items-center gap-3">
                        <div className={`text-3xl font-black ${hrv.ppgLevel <= 2 ? 'text-emerald-600' :
                          hrv.ppgLevel <= 4 ? 'text-yellow-600' :
                            'text-rose-600'
                          }`}>Lev.{hrv.ppgLevel}</div>
                        <div>
                          <p className={`text-sm font-bold ${hrv.ppgLevel <= 2 ? 'text-emerald-700' :
                            hrv.ppgLevel <= 4 ? 'text-yellow-700' :
                              'text-rose-700'
                            }`}>
                            {hrv.ppgLevel === 1 ? '혈관 상태: 매우 좋음' :
                              hrv.ppgLevel === 2 ? '혈관 상태: 좋음' :
                                hrv.ppgLevel === 3 ? '혈관 상태: 보통' :
                                  hrv.ppgLevel === 4 ? '혈관 상태: 다소 나쁨' :
                                    hrv.ppgLevel === 5 ? '혈관 상태: 나쁨' :
                                      hrv.ppgLevel === 6 ? '혈관 상태: 꽤 나쁨' :
                                        '혈관 상태: 매우 나쁨'}
                          </p>
                          <p className={`text-[10px] mt-1 ${hrv.ppgLevel <= 2 ? 'text-emerald-600' :
                            hrv.ppgLevel <= 4 ? 'text-yellow-600' :
                              'text-rose-600'
                            }`}>
                            {hrv.ppgLevel === 1 ? '혈관 탄력성이 매우 우수합니다. 혈액 순환이 원활하여 뇌 기능에 최적의 환경입니다.' :
                              hrv.ppgLevel === 2 ? '혈관 상태가 양호합니다. 현재 생활 습관을 유지하세요.' :
                                hrv.ppgLevel === 3 ? '평균적인 혈관 상태입니다. 규칙적인 운동을 권장합니다.' :
                                  hrv.ppgLevel === 4 ? '혈관 탄력성이 다소 저하되었습니다. 스트레칭과 가벼운 운동을 권장합니다.' :
                                    hrv.ppgLevel === 5 ? '혈관 건강에 주의가 필요합니다. 생활 습관 개선이 필요합니다.' :
                                      hrv.ppgLevel === 6 ? '혈관 건강이 저하되었습니다. 전문가 상담을 권장합니다.' :
                                        '혈관 건강이 매우 나쁛니다. 의료 전문가 상담이 필요합니다.'}
                          </p>
                        </div>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>
          )}
          <div className="flex gap-4">
            <button onClick={() => setStep('protocol')} className="flex-1 py-4 bg-white border border-slate-200 text-slate-600 font-bold rounded-2xl hover:bg-slate-50 transition-all">Back</button>
            <button
              onClick={() => {
                if (config.useBrainBody) setStep('eeg');
                else if (config.isMedicalMode) setStep('bloodtest');
                else handleFinalAssessment();
              }}
              className="flex-[2] py-4 bg-blue-600 text-white font-bold rounded-2xl shadow-lg hover:bg-blue-700 transition-all"
            >
              {config.useBrainBody ? 'Next: EEG Analysis' : config.isMedicalMode ? 'Next: Blood Test' : 'Generate Report'}
            </button>
          </div>
        </div >
      </Layout >
    );
  }

  if (step === 'eeg') {
    return (
      <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu} isDarkMode={isDarkMode} onToggleDarkMode={toggleDarkMode}>
        <StepProgressBar currentStep={step} isMedicalMode={config.isMedicalMode} />
        <div className="max-w-4xl mx-auto space-y-8 animate-in fade-in duration-500 pb-20 mt-4">
          <div className="flex flex-col items-center text-center gap-4">
            <img src="/EEG logo.JPG" alt="EEG Logo" className="w-24 h-24 object-contain" />
            <div>
              <h2 className="text-3xl font-extrabold text-slate-900">Step 5: EEG Biometrics</h2>
              <p className="text-slate-500 mt-2">종합 뇌파 분석 리포트의 데이터를 입력하십시오.</p>
            </div>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
            {/* 종합 뇌파 분석 */}
            <div className="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-8">
              <div className="flex items-center gap-2 border-b border-slate-100 pb-4">
                <div className="w-2 h-6 bg-violet-600 rounded-full"></div>
                <h3 className="font-bold text-slate-800 text-xl">종합 뇌파 분석</h3>
              </div>

              <div className="space-y-6">
                <div className="bg-violet-50 p-6 rounded-2xl border border-violet-100">
                  <label className="block text-sm font-bold text-violet-800 mb-2">뇌 건강점수 (Brain Score)</label>
                  <div className="flex items-center gap-4">
                    <input type="number" value={hrv.brainScore || ''} onChange={e => setHrv({ ...hrv, brainScore: e.target.value ? parseInt(e.target.value, 10) || 0 : 0 })} className="flex-1 p-4 bg-white border border-violet-200 rounded-xl font-black text-2xl text-violet-600 text-center" />
                    <span className="font-bold text-violet-400 text-xl">점</span>
                  </div>
                </div>

                <div className="space-y-4">
                  <label className="block text-sm font-bold text-slate-700">뇌파 비율 (%) 및 우세 유형 선택</label>
                  <p className="text-[10px] text-violet-600 bg-violet-50 p-2 rounded-lg">💡 PPG/EEG 검사 결과에서 각 뇌파의 비율(%)을 입력하고, 가장 우세한 뇌파를 선택하세요.</p>
                  <div className="grid grid-cols-2 gap-4">
                    {[
                      { label: 'Gamma', key: 'eegGamma', freq: '29.7-39.5Hz', state: '불안, 흥분시 우세', color: 'rose', emoji: '⚡' },
                      { label: 'H-Beta', key: 'eegHBeta', freq: '19.5-29.2Hz', state: '긴장, 스트레스시 우세', color: 'orange', emoji: '😰' },
                      { label: 'M-Beta', key: 'eegMBeta', freq: '14.6-19.0Hz', state: '집중, 몰입시 우세', color: 'emerald', emoji: '🎯' },
                      { label: 'L-Beta', key: 'eegLBeta', freq: '11.7-14.1Hz', state: '주변인식시 우세', color: 'blue', emoji: '👀' },
                      { label: 'Alpha', key: 'eegAlpha', freq: '7.8-11.2Hz', state: '안정시 우세', color: 'green', emoji: '😌' },
                      { label: 'Theta', key: 'eegTheta', freq: '5.9-7.3Hz', state: '수면시 우세', color: 'indigo', emoji: '😴' }
                    ].map(item => (
                      <div key={item.key} className={`p-4 rounded-2xl border transition-all flex flex-col gap-2 ${hrv.dominantEEG === item.label ? 'bg-indigo-600 border-indigo-600 text-white shadow-md' : 'bg-slate-50 border-slate-200 text-slate-600'}`}>
                        <div className="flex justify-between items-center">
                          <div className="flex items-center gap-2">
                            <span className="text-lg">{item.emoji}</span>
                            <div>
                              <span className="text-xs font-bold uppercase tracking-wider">{item.label}</span>
                              <p className={`text-[9px] ${hrv.dominantEEG === item.label ? 'text-white/70' : 'text-slate-400'}`}>{item.freq}</p>
                            </div>
                          </div>
                          <input
                            type="radio"
                            name="dominantEEG"
                            checked={hrv.dominantEEG === item.label}
                            onChange={() => setHrv({ ...hrv, dominantEEG: item.label })}
                            className="accent-white h-4 w-4"
                          />
                        </div>
                        <p className={`text-[10px] font-medium ${hrv.dominantEEG === item.label ? 'text-white/80' : 'text-slate-500'}`}>{item.state}</p>
                        <input
