                        <input type="number" value={hrv.physicalStress || ''} onChange={e => setHrv({ ...hrv, physicalStress: e.target.value ? parseInt(e.target.value, 10) || 0 : 0 })} className="w-full p-3 bg-white border border-red-200 rounded-xl font-bold text-red-600" placeholder="예: 53" />
