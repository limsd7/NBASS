                      <p className={`text-[10px] ${portableHrv.rmssd < 20 ? 'text-red-500' :
                        portableHrv.rmssd < 40 ? 'text-yellow-500' :
                          'text-emerald-500'
                        }`}>
                        {portableHrv.rmssd < 20 ? '🚨 회복력 부족' :
                          portableHrv.rmssd < 40 ? '😐 보통' :
                            '✅ 우수한 회복력'}
                      </p>
