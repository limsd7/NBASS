                    {portableHrv.sdnn > 0 && (
                      <p className={`text-[10px] ${portableHrv.sdnn < 30 ? 'text-red-500' :
                        portableHrv.sdnn < 50 ? 'text-orange-500' :
                          'text-emerald-500'
                        }`}>
                        {portableHrv.sdnn < 30 ? '🚨 HRV 매우 낮음' :
                          portableHrv.sdnn < 50 ? '⚠️ 스트레스 주의' :
                            '✅ 양호'}
                      </p>
