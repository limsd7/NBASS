                          onChange={e => setHrv({ ...hrv, [item.key]: Number(e.target.value) })}
                          className={`w-full p-2 bg-white/10 border border-white/20 rounded-lg text-sm font-bold focus:outline-none ${hrv.dominantEEG === item.label ? 'text-white' : 'text-slate-900 bg-white border-slate-200'}`}
                          placeholder="%"
                        />
                      </div>
                    ))}
                  </div>
                  {hrv.dominantEEG && (
                    <div className={`p-4 rounded-xl border ${hrv.dominantEEG === 'M-Beta' || hrv.dominantEEG === 'Alpha' ? 'bg-emerald-50 border-emerald-200' :
                      hrv.dominantEEG === 'L-Beta' ? 'bg-blue-50 border-blue-200' :
                        hrv.dominantEEG === 'Theta' ? 'bg-indigo-50 border-indigo-200' :
                          'bg-orange-50 border-orange-200'
                      }`}>
                      <p className={`text-[11px] font-medium ${hrv.dominantEEG === 'M-Beta' || hrv.dominantEEG === 'Alpha' ? 'text-emerald-700' :
                        hrv.dominantEEG === 'L-Beta' ? 'text-blue-700' :
