                </div>
              </div>
            </div>
          )}

          {/* ========== 기존 BrainBody HRV UI (Portable 모드에서는 숨김) ========== */}
          {(config.useBrainBody || !config.usePortable) && (
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
