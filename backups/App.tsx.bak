type SurveyTab = 'ans' | 'bai' | 'isi' | 'concentration' | 'cfs';

const App: React.FC = () => {
  const [step, setStep] = useState<'register' | 'surveys' | 'protocol' | 'hrv' | 'eeg' | 'loading' | 'results'>('register');
  const [activeMenu, setActiveMenu] = useState<'dashboard' | 'assessment' | 'history' | 'resources'>('dashboard');
  const [activeTab, setActiveTab] = useState<SurveyTab>('ans');
  const [student, setStudent] = useState<StudentInfo>(initialStudent);
  const [hrv, setHrv] = useState<HRVData>(initialHRV);
  const [protocol, setProtocol] = useState<ProtocolData>(initialProtocol);
  const [isCustomLoc, setIsCustomLoc] = useState(false);

  // Survey States
  const [snsSymptomSelection, setSnsSymptomSelection] = useState<string[]>([]);
  const [pnsSymptomSelection, setPnsSymptomSelection] = useState<string[]>([]);
  const [baiAnswers, setBaiAnswers] = useState<number[]>(new Array(21).fill(0));
  const [isiAnswers, setIsiAnswers] = useState<number[]>(new Array(7).fill(0));
  const [concentrationAnswers, setConcentrationAnswers] = useState<number[]>(new Array(7).fill(0));
  const [fatigueCore, setFatigueCore] = useState<boolean>(false);
  const [fatigueSymptoms, setFatigueSymptoms] = useState<boolean[]>(new Array(8).fill(false));

  // BAI specific sub-tab state
  const [baiSubPage, setBaiSubPage] = useState<1 | 2>(1);


  const [result, setResult] = useState<AssessmentResult | null>(null);

  // Configuration State
  const [showConfig, setShowConfig] = useState(false);
  const [config, setConfig] = useState({
    isExamMode: true,
    showDetail: true
  });

  // Strategy State needed for customization
  const [strategies, setStrategies] = useState<StrategyMap>(DEFAULT_STRATEGIES);

  // ê³¼ëª©ë³??„ëµ ? íƒ State (Checkbox IDs)
  const [selectedSubjectOptions, setSelectedSubjectOptions] = useState<Record<string, string[]>>({
    korean: ['kor_1'],
    math: ['math_psy_1', 'math_phy_1', 'math_routine_1'],
    english: ['eng_1']
  });

  // Student Checklist State (?™ìƒ???¤ì²œ ?¬ë? ì²´í¬)
  const [completedItems, setCompletedItems] = useState<string[]>([]);

  // History State
  const [history, setHistory] = useState<{ date: string, type: CareType, score: number }[]>([]);

  const [activeConfigTab, setActiveConfigTab] = useState<'general' | 'strategy' | 'subject'>('general');
  const [editingStrategyType, setEditingStrategyType] = useState<CareType>(CareType.BURNOUT);

  // Load History on Mount
  useEffect(() => {
    const saved = localStorage.getItem('sn1_history');
    if (saved) {
      try {
        setHistory(JSON.parse(saved));
      } catch (e) {
        console.error('Failed to parse history', e);
      }
    }
  }, []);

  // Save Result to History when result is generated
  useEffect(() => {
    if (step === 'results' && result) {
      const newEntry = {
        date: new Date().toISOString(),
        type: result.careType,
        score: result.score
      };

      setHistory(prev => {
        // Prevent duplicate save if last entry is same type/score and very recent (e.g. within 1 min)
        if (prev.length > 0) {
          const last = prev[0];
          if (last.type === newEntry.type && last.score === newEntry.score &&
            new Date().getTime() - new Date(last.date).getTime() < 60000) {
            return prev;
          }
        }
        const updated = [newEntry, ...prev].slice(0, 10); // Keep last 10
        localStorage.setItem('sn1_history', JSON.stringify(updated));
        return updated;
      });
    }
  }, [step, result]);

  const toggleCompleted = (id: string) => {
    setCompletedItems(prev =>
      prev.includes(id) ? prev.filter(i => i !== id) : [...prev, id]
    );
  };

  // Hidden Admin Menu State
  const [showAdminPassword, setShowAdminPassword] = useState(false);
  const [adminPasswordInput, setAdminPasswordInput] = useState('');
  const [isAdminUnlocked, setIsAdminUnlocked] = useState(false);

  const handleAdminUnlock = () => {
    if (adminPasswordInput === '3123') {
      setIsAdminUnlocked(true);
      setShowAdminPassword(false);
      setShowConfig(true);
      setActiveConfigTab('subject'); // ë°”ë¡œ ê³¼ëª© ?¤ì • ??œ¼ë¡??´ë™
    } else {
      alert('Password Incorrect');
    }
  };

  useEffect(() => {
    setStudent(prev => ({ ...prev, age: calculateAge(prev.birthDate) }));
  }, [student.birthDate]);

  const calculateAge = (birthDate: string) => {
    if (!birthDate) return 0;
    const today = new Date();
    const birth = new Date(birthDate);
    let age = today.getFullYear() - birth.getFullYear();
    const m = today.getMonth() - birth.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) {
      age--;
    }
    return age;
  }

  const handleBirthDateChange = (date: string) => {
    setStudent(prev => ({
      ...prev,
      birthDate: date,
      age: calculateAge(date)
    }));
  };

  const surveyScores = useMemo(() => {
    const bai = baiAnswers.reduce((a, b) => a + b, 0);
    const isi = isiAnswers.reduce((a, b) => a + b, 0);
    const concentration = concentrationAnswers.reduce((a, b) => a + b, 0);
    const fatigueCount = fatigueSymptoms.filter(s => s).length;
    const snsCount = snsSymptomSelection.length;
    const pnsCount = pnsSymptomSelection.length;
    return { bai, isi, concentration, fatigueCount, snsCount, pnsCount, isChronicFatigue: fatigueCore && fatigueCount >= 4 };
  }, [baiAnswers, isiAnswers, concentrationAnswers, fatigueCore, fatigueSymptoms, snsSymptomSelection, pnsSymptomSelection]);

  const baiEvaluation = useMemo(() => {
    const score = surveyScores.bai;
    if (score <= 9) return { text: "?•ìƒ???˜ì?", color: "text-emerald-600" };
    if (score <= 18) return { text: "ê²½ë????˜ì???ë¶ˆì•ˆ", color: "text-blue-600" };
    if (score <= 29) return { text: "?ë‹¹???˜ì???ë¶ˆì•ˆ (ê´€ì°??”ë§)", color: "text-orange-600" };
    return { text: "?¬í•œ ?˜ì???ë¶ˆì•ˆ (?„ë¬¸???ë‹´ ê¶Œê³ )", color: "text-red-600" };
  }, [surveyScores.bai]);

  const isiEvaluation = useMemo(() => {
    const score = surveyScores.isi;
    if (score <= 7) return { text: "? ì˜? ë§Œ??ë¶ˆë©´ì¦ì´ ?†ìŠµ?ˆë‹¤.", color: "text-emerald-600" };
    if (score <= 14) return { text: "?½ê°„??ë¶ˆë©´ê²½í–¥???ˆìŠµ?ˆë‹¤.", color: "text-blue-600" };
    if (score <= 21) return { text: "ì¤‘ì¦?„ì˜ ë¶ˆë©´ì¦ì´ ?ˆìŠµ?ˆë‹¤.", color: "text-orange-600" };
    return { text: "?¬í•œ ë¶ˆë©´ì¦ì´ ?ˆìŠµ?ˆë‹¤.", color: "text-red-600" };
  }, [surveyScores.isi]);

  const handleFinalAssessment = async () => {
    setStep('loading');

    const surveyData: SurveyData = {
      gad7: 5,
      bai: surveyScores.bai,
      isi: surveyScores.isi,
      concentrationScore: surveyScores.concentration,
      chronicFatigue: surveyScores.isChronicFatigue,
      fatigueSymptomsCount: surveyScores.fatigueCount,
      symptoms: FATIGUE_SYMPTOMS.filter((_, i) => fatigueSymptoms[i]),
      sympatheticSymptoms: snsSymptomSelection,
      parasympatheticSymptoms: pnsSymptomSelection
    };

    // UXë¥??„í•œ ?¸ìœ„?ì¸ ?œë ˆ??(ë¶„ì„ ì¤??ë‚Œ)
    await new Promise(resolve => setTimeout(resolve, 1500));


    const type = CLASSIFY_STUDENT(hrv, surveyData);
    // NEW: Logic Engine Analysis with Config
    const analysis = generateClinicalAnalysis(hrv, surveyData, protocol, type, config.isExamMode);

    setResult({
      student,
      careType: type,
      hrv,
      survey: surveyData,
      protocol,
      nutrition: SOLUTIONS[type].nutrition,
      careGuide: SOLUTIONS[type].care,
      analysisText: analysis,
      score: surveyScores.bai // Using BAI score as a representative score for history
    });
    setStep('results');
  };

  const toggleSnsSymptom = (s: string) => {
    setSnsSymptomSelection(prev => prev.includes(s) ? prev.filter(i => i !== s) : [...prev, s]);
  };

  const togglePnsSymptom = (s: string) => {
    setPnsSymptomSelection(prev => prev.includes(s) ? prev.filter(i => i !== s) : [...prev, s]);
  };

  if (step === 'register') {
    return (
      <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu}>
        <div className="max-w-2xl mx-auto bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-500">
          <div className="bg-blue-600 p-8 text-white">
            <h2 className="text-2xl font-bold">Student Registration</h2>
            <p className="text-blue-100 mt-1">ê¸°ë³¸ ?•ë³´ë¥??…ë ¥?˜ì—¬ ì§„ë‹¨???œì‘?˜ì‹­?œì˜¤.</p>
          </div>
          <div className="p-8 space-y-6">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">Serial ID (?ë™ ?ì„±)</label>
                <div className="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-slate-500 font-mono text-sm">{student.id}</div>
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">ê²€???¼ì (Test Date)</label>
                <input type="date" value={student.testDate} onChange={e => setStudent({ ...student, testDate: e.target.value })} className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all" />
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">?±ëª… (Full Name)</label>
                <input type="text" placeholder="?±ëª…???…ë ¥?˜ì„¸?? value={student.name} onChange={e => setStudent({ ...student, name: e.target.value })} className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all" />
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">?™ë…„ (Grade)</label>
                <select value={student.grade} onChange={e => setStudent({ ...student, grade: e.target.value })} className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all">
                  {GRADE_OPTIONS.map(g => <option key={g} value={g}>{g}</option>)}
                </select>
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">?ë…„?”ì¼ (Birthdate)</label>
                <input type="date" value={student.birthDate} onChange={e => handleBirthDateChange(e.target.value)} className="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:outline-none transition-all" />
              </div>
              <div className="space-y-2">
                <label className="text-sm font-bold text-slate-700">?˜ì´ (Age)</label>
                <div className="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-slate-600 font-bold">{student.age} ??/div>
              </div>
              <div className="space-y-2 md:col-span-2">
                <label className="text-sm font-bold text-slate-700">?±ë³„ (Gender)</label>
                <div className="flex gap-4">
                  {['Male', 'Female'].map((g) => (
                    <button
                      key={g}
                      onClick={() => setStudent({ ...student, gender: g as any })}
                      className={`flex-1 py-3 rounded-xl font-bold transition-all border ${student.gender === g ? 'bg-blue-600 text-white border-blue-600 shadow-md' : 'bg-white text-slate-400 border-slate-200'}`}
                    >
                      {g === 'Male' ? '?¨ì„±' : '?¬ì„±'}
                    </button>
                  ))}
                </div>
              </div>

              <div className="space-y-2 md:col-span-2">
                <label className="text-sm font-bold text-slate-700">ê°€??ë¶€?´ë˜??ê³¼ëª© (Focus Subject)</label>
                <div className="grid grid-cols-3 gap-4">
                  {(['korean', 'math', 'english'] as const).map(subj => (
                    <button
                      key={subj}
                      onClick={() => setStudent({ ...student, weakSubject: subj })}
                      className={`py-3 rounded-xl font-bold border transition-all ${student.weakSubject === subj ? 'bg-indigo-600 text-white border-indigo-600 shadow-md' : 'bg-white text-slate-400 border-slate-200'}`}
                    >
                      {subj === 'korean' ? 'êµ?–´ (Korean)' : subj === 'math' ? '?˜í•™ (Math)' : '?ì–´ (English)'}
                    </button>
                  ))}
                </div>
              </div>
            </div>
            <button onClick={() => setStep('surveys')} disabled={!student.name} className="w-full py-4 bg-blue-600 text-white font-bold rounded-2xl shadow-lg hover:bg-blue-700 disabled:opacity-50 transition-all mt-4">ê²€???œì‘ (Start Assessment)</button>
          </div>
        </div>
      </Layout>
    );
  }

  if (step === 'surveys') {
    return (
      <Layout activeMenu={activeMenu} onMenuChange={setActiveMenu}>
        <div className="max-w-4xl mx-auto space-y-6 pb-20">
          <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm sticky top-20 z-40 flex items-center justify-between">
            <h3 className="text-lg font-bold text-slate-900">Psychological Assessment</h3>
            <div className="flex gap-4 overflow-x-auto pb-1">
              <div className="text-right">
                <p className="text-[10px] text-slate-400 uppercase font-bold">Sym</p>
                <p className="text-lg font-bold text-red-600">{surveyScores.snsCount}</p>
              </div>
              <div className="text-right">
                <p className="text-[10px] text-slate-400 uppercase font-bold">Para</p>
                <p className="text-lg font-bold text-blue-600">{surveyScores.pnsCount}</p>
              </div>
              <div className="text-right border-l pl-4">
                <p className="text-[10px] text-slate-400 uppercase font-bold">Focus</p>
                <p className="text-lg font-bold text-amber-600">{surveyScores.concentration}</p>
              </div>
              <div className="text-right">
                <p className="text-[10px] text-slate-400 uppercase font-bold">BAI</p>
                <p className="text-lg font-bold text-indigo-600">{surveyScores.bai}</p>
              </div>
              <div className="text-right">
                <p className="text-[10px] text-slate-400 uppercase font-bold">ISI</p>
                <p className="text-lg font-bold text-emerald-600">{surveyScores.isi}</p>
              </div>
            </div>
          </div>

          <div className="flex bg-white p-1 rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
            {['ans', 'bai', 'isi', 'concentration', 'cfs'].map(t => (
              <button key={t} onClick={() => setActiveTab(t as any)} className={`flex-1 py-3 text-sm font-bold rounded-xl transition-all ${activeTab === t ? 'bg-slate-900 text-white' : 'text-slate-400 hover:bg-slate-50'}`}>
                {t === 'bai' ? 'ë¶ˆì•ˆ (BAI)' : t === 'isi' ? '?˜ë©´ (ISI)' : t === 'concentration' ? 'ì§‘ì¤‘?? : t.toUpperCase()}
              </button>
            ))}
          </div>

          <div className="animate-in fade-in duration-300">
            {activeTab === 'ans' && (
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div className="bg-white rounded-3xl border border-slate-200 overflow-hidden">
                  <div className="p-4 bg-red-600 text-white font-bold text-center">Sympathetic</div>
                  <div className="p-6 grid gap-2 bg-slate-50">
                    {SYMPATHETIC_SYMPTOMS.map(s => (
                      <label key={s} className={`flex items-center gap-3 p-3 rounded-xl border ${snsSymptomSelection.includes(s) ? 'bg-red-50 border-red-500' : 'bg-white'}`}>
                        <input type="checkbox" checked={snsSymptomSelection.includes(s)} onChange={() => toggleSnsSymptom(s)} className="accent-red-600" />
                        <span className="text-sm font-medium">{s}</span>
                      </label>
                    ))}
                  </div>
                </div>
                <div className="bg-white rounded-3xl border border-slate-200 overflow-hidden">
                  <div className="p-4 bg-blue-700 text-white font-bold text-center">Parasympathetic</div>
                  <div className="p-6 grid gap-2 bg-slate-50">
                    {PARASYMPATHETIC_SYMPTOMS.map(s => (
                      <label key={s} className={`flex items-center gap-3 p-3 rounded-xl border ${pnsSymptomSelection.includes(s) ? 'bg-blue-50 border-blue-500' : 'bg-white'}`}>
                        <input type="checkbox" checked={pnsSymptomSelection.includes(s)} onChange={() => togglePnsSymptom(s)} className="accent-blue-700" />
                        <span className="text-sm font-medium">{s}</span>
                      </label>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {activeTab === 'bai' && (
              <div className="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
                <div className="p-6 border-b border-slate-100 flex gap-1">
                  {([1, 2] as const).map(p => (
