    const getRecommendedProducts = () => {
      const productIds = new Set<string>();

      // Base: ëª¨ë“  ?˜í—˜?ì—ê²?ë©´ì—­ ê´€ë¦¬ëŠ” ?„ìˆ˜ (?ê²½ì²??„ì—°/ë¹„í?ë¯¼B)
      productIds.add('immune_one');

