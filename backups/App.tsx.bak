                    </div>
                  </div>
                )}
              </div>
              <div className="p-4 border-t border-slate-100 bg-slate-50">
                <button onClick={() => setShowConfig(false)} className="w-full py-3 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition">Close & Apply</button>
              </div>
            </div>
          </div>
        )}

        {/* Admin Password Modal */}
        {showAdminPassword && (
          <div className="fixed inset-0 z-[60] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 animate-in fade-in duration-200">
            <div className="bg-white p-6 rounded-2xl shadow-2xl w-full max-w-xs">
              <h3 className="font-bold text-lg mb-4 text-slate-800">Admin Access Required</h3>
              <input
                type="password"
                className="w-full p-3 border rounded-xl mb-4 focus:ring-2 focus:ring-indigo-500 outline-none"
                placeholder="Enter Password"
                value={adminPasswordInput}
                onChange={e => setAdminPasswordInput(e.target.value)}
                autoFocus
              />
              <div className="flex justify-end gap-2">
                <button onClick={() => { setShowAdminPassword(false); setAdminPasswordInput(''); }} className="px-4 py-2 text-slate-500 font-bold hover:bg-slate-100 rounded-lg">Cancel</button>
                <button onClick={handleAdminUnlock} className="px-4 py-2 bg-indigo-600 text-white font-bold rounded-lg hover:bg-indigo-700">Confirm</button>
              </div>
            </div>
          </div>
        )}

        <div className="space-y-8 animate-in fade-in duration-500 pb-20 relative">

          {/* Header & Controls */}
          <div className="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex flex-col md:flex-row justify-between items-center gap-6">
            <div className="flex items-center gap-6">
              <div className="w-16 h-16 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-600 font-bold text-xl">
                {result.student.gender === 'Male' ? 'M' : 'F'}
              </div>
              <div>
                <h2 className="text-2xl font-bold text-slate-900">{result.student.name} <span className="text-sm font-normal text-slate-400">ID: {result.student.id}</span></h2>
                <p className="text-sm text-slate-500">{result.student.grade} ??{result.student.age}????{result.student.gender === 'Male' ? '?¨ì„±' : '?¬ì„±'} ??ê²€?¬ì¼: {result.student.testDate}</p>
                {result.student.weakSubject && (
                  <span className="inline-block mt-1 px-2 py-0.5 bg-indigo-100 text-indigo-700 text-xs font-bold rounded">
                    Focus: {result.student.weakSubject.toUpperCase()}
                  </span>
                )}
              </div>
            </div>
            <div className="flex gap-3 no-print">
              <button onClick={() => setShowConfig(true)} className="p-3 text-slate-400 hover:text-slate-600 bg-slate-50 rounded-xl transition-colors" title="Settings">
                <svg xmlns="http://www.w3.org/2000/svg" className="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0-.73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" /><circle cx="12" cy="12" r="3" /></svg>
              </button>
              <button
                onClick={() => window.print()}
                className="px-6 py-2 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition-colors flex items-center gap-1 font-bold"
              >
                ?–¨ï¸?PDF / ?¸ì‡„
              </button>
              <button onClick={() => { setStep('register'); setProtocol(initialProtocol); setIsCustomLoc(false); }} className="px-6 py-2 bg-slate-900 text-white rounded-xl hover:bg-slate-800 transition-colors">New Assessment</button>
            </div>
          </div>

          <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div className="lg:col-span-1 bg-gradient-to-br from-slate-900 to-slate-800 rounded-2xl p-6 text-white shadow-xl">
              <p className="text-slate-400 text-xs font-bold uppercase tracking-widest">Selected Environment</p>
              <h3 className="text-2xl font-bold mt-1 text-blue-400">{result.protocol.location}</h3>
              <div className="mt-8 space-y-4">
                <div className="bg-white/5 p-4 rounded-xl">
                  <p className="text-[10px] text-slate-400 uppercase font-bold">Brain Health Score</p>
                  <p className="text-xl font-bold">{result.hrv.brainScore} pts</p>
                </div>
                <div className="bg-white/5 p-4 rounded-xl">
                  <p className="text-[10px] text-slate-400 uppercase font-bold">Dominant EEG</p>
                  <p className="text-xl font-bold text-indigo-400">{result.hrv.dominantEEG}</p>
                </div>
                <div className="bg-white/5 p-4 rounded-xl">
                  <p className="text-[10px] text-slate-400 uppercase font-bold">Anxiety (BAI)</p>
                  <p className="text-xl font-bold">{result.survey.bai} / 63</p>
                </div>
              </div>
            </div>
            <div className="lg:col-span-2 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
              <div className="flex items-center gap-3 mb-6">
                <div className="w-1.5 h-6 bg-blue-600 rounded-full"></div>
                <h3 className="text-xl font-bold text-slate-900">Expert Integrated Neuro-Insight</h3>
                {/* Admin Trigger (Hidden Lock) */}
                <button onClick={() => setShowAdminPassword(true)} className="opacity-0 hover:opacity-100 p-1 text-slate-300 hover:text-slate-500 transition-opacity">?”’</button>
              </div>

              {/* Subject Strategy Card (Conditional) */}
              {config.isExamMode && result.student.weakSubject && (
                <div className="bg-gradient-to-br from-indigo-50 to-white border border-indigo-100 p-8 rounded-3xl mb-8 shadow-sm">
                  <h4 className="font-bold text-indigo-900 flex items-center gap-3 mb-6 text-xl">
                    <span className="text-2xl">?¯</span>
                    {result.student.weakSubject === 'korean' ? 'êµ?–´' : result.student.weakSubject === 'math' ? '?˜í•™' : '?ì–´'} ?œê°„/ë©˜íƒˆ ê´€ë¦?ê³µëµ
                  </h4>

                  <div className="space-y-6">
                    {/* Render selected options for the weak subject */}
                    {(() => {
                      const subj = result.student.weakSubject!;
                      const selectedIds = selectedSubjectOptions[subj] || [];
                      // Filter options that are selected
                      const options = (SUBJECT_OPTIONS_MAP[subj] || []).filter(o => selectedIds.includes(o.id));

                      if (options.length === 0) return <p className="text-sm text-slate-400">? íƒ???„ëµ???†ìŠµ?ˆë‹¤.</p>;

                      // Group by category again for display
                      const categories = Array.from(new Set(options.map(o => o.category))).sort();

                      return categories.map(cat => (
                        <div key={cat} className="bg-white/60 p-5 rounded-2xl border border-indigo-50/50">
                          <h5 className="font-bold text-indigo-600 text-sm mb-3 uppercase tracking-wide border-b border-indigo-100 pb-2">{cat}</h5>
                          <ul className="space-y-4">
                            {options.filter(o => o.category === cat).map(opt => (
                              <li key={opt.id} className="flex gap-3 text-sm text-slate-700 leading-relaxed cursor-pointer group" onClick={() => toggleCompleted(opt.id)}>
                                <div className={`mt-1 min-w-[16px] h-4 rounded border flex items-center justify-center transition-colors ${completedItems.includes(opt.id) ? 'bg-indigo-500 border-indigo-500' : 'border-slate-300 bg-white group-hover:border-indigo-400'}`}>
                                  {completedItems.includes(opt.id) && <span className="text-white text-[10px]">??/span>}
                                </div>
                                <div className={`${completedItems.includes(opt.id) ? 'opacity-50 line-through decoration-slate-400' : ''}`}>
                                  <span className="font-bold text-slate-900 block mb-1">{opt.title}</span>
                                  <span className="text-slate-600">{opt.content}</span>
                                </div>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ));
                    })()}
                  </div>
                </div>
              )}

              <div className={`prose prose-slate max-w-none text-slate-700 leading-relaxed whitespace-pre-wrap ${config.showDetail ? 'text-base' : 'text-sm'}`}>
                {result.analysisText}
              </div>
            </div>
          </div>

          {/* Expanded 2x2 Chart Grid */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm h-80">
              <h4 className="text-sm font-bold text-slate-500 uppercase mb-4">Autonomic Balance (ANS)</h4>
              <BalanceChart sns={result.hrv.sns} pns={result.hrv.pns} />
            </div>
            <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm h-80">
              <h4 className="text-sm font-bold text-slate-500 uppercase mb-4">Vitality & Fatigue Index</h4>
              <VitalityBarChart vitality={result.hrv.vitality} fatigue={result.hrv.fatigue} />
            </div>
            <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm h-80">
              <h4 className="text-sm font-bold text-slate-500 uppercase mb-4">Brain Balance Radar</h4>
              <BrainRadarChart
                gamma={result.hrv.eegGamma}
                hBeta={result.hrv.eegHBeta}
                mBeta={result.hrv.eegMBeta}
                lBeta={result.hrv.eegLBeta}
                alpha={result.hrv.eegAlpha}
                theta={result.hrv.eegTheta}
              />
            </div>
            <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm h-80">
              <h4 className="text-sm font-bold text-slate-500 uppercase mb-6">Stress & Concentration Gauge</h4>
              <div className="space-y-6 pt-4">
                <StressGaugeChart stress={result.protocol.stressLevel} label="Self-Reported Stress" color="text-red-600" />
                <StressGaugeChart stress={result.hrv.concentrationLevel || 5} label="Clinical Concentration" color="text-emerald-600" />
              </div>
            </div>
          </div>

          {/* PNT Mall Targeted Nutrition (No Links) */}
          <div className="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm">
            <div className="flex items-center gap-3 mb-8">
              <div className="w-1.5 h-6 bg-emerald-500 rounded-full"></div>
              <h3 className="text-xl font-bold text-slate-900">Targeted Nutrition Recommendation</h3>
            </div>

            {getRecommendedProducts().length === 0 ? (
              <p className="text-slate-500 text-sm">?„ì¬ ?íƒœ???¹ì´?¬í•­???†ì–´ ?„ìˆ˜ ?ì–‘???´ë???ë§?ê¶Œì¥?©ë‹ˆ??</p>
            ) : (
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {getRecommendedProducts().map(product => (
                  <div key={product.id} className="group block bg-white border border-slate-100 rounded-2xl overflow-hidden hover:shadow-lg hover:border-slate-200 transition-all duration-300">
                    <div className="aspect-[4/3] bg-slate-50 overflow-hidden relative">
                      <img src={product.image} alt={product.name} className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      <div className="absolute top-3 left-3 flex flex-wrap gap-1">
                        {product.tags.map(tag => (
                          <span key={tag} className="px-2 py-1 bg-white/90 backdrop-blur text-[10px] font-bold text-slate-700 rounded-lg">{tag}</span>
                        ))}
                      </div>
                    </div>
                    <div className="p-5">
                      <h4 className="font-bold text-slate-900 group-hover:text-emerald-600 transition-colors">{product.name}</h4>
                      <p className="text-xs text-slate-500 mt-1">{product.subName}</p>
                      <div className="mt-4 pt-4 border-t border-slate-50">
                        <p className="text-[10px] text-slate-400 font-bold uppercase mb-1">Key Ingredients</p>
                        <div className="flex flex-wrap gap-y-1 gap-x-2">
                          {product.ingredients.map((ing, i) => (
                            <span key={i} className="text-xs text-emerald-700 font-medium bg-emerald-50 px-2 py-0.5 rounded">{ing}</span>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* NEW: Personalized Exam Strategy Section */}
          {config.isExamMode && result.careType && strategies[result.careType] && (
            <div className="bg-slate-900 p-8 rounded-3xl text-white shadow-2xl relative overflow-hidden mt-8">
              <div className="absolute top-0 right-0 w-64 h-64 bg-blue-500 rounded-full blur-[100px] opacity-20 transform translate-x-1/2 -translate-y-1/2"></div>
              <div className="relative z-10">
                <div className="flex items-center gap-3 mb-8">
                  <div className="w-1.5 h-6 bg-blue-400 rounded-full"></div>
                  <div>
                    <h3 className="text-xl font-bold">Personalized Exam Strategy</h3>
                    <p className="text-slate-400 text-sm">Type-Based Optimization : {result.careType}</p>
                  </div>
                </div>

                <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                  {/* 1. Nutrition */}
                  <div className="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/10 hover:bg-white/15 transition-colors">
                    <div className="flex items-center gap-3 mb-4">
                      <span className="text-2xl">?’Š</span>
                      <h4 className="font-bold text-blue-300">Nutrition Routine</h4>
                    </div>
                    <p className="text-sm text-slate-300 whitespace-pre-line leading-relaxed">{strategies[result.careType].nutritionGuide}</p>
                  </div>
                  {/* 2. Study */}
                  <div className="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/10 hover:bg-white/15 transition-colors">
                    <div className="flex items-center gap-3 mb-4">
                      <span className="text-2xl">??/span>
                      <h4 className="font-bold text-indigo-300">Study Strategy</h4>
                    </div>
                    <p className="text-sm text-slate-300 whitespace-pre-line leading-relaxed">{strategies[result.careType].studyStrategy}</p>
                  </div>
                  {/* 3. Exercise */}
                  <div className="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/10 hover:bg-white/15 transition-colors">
                    <div className="flex items-center gap-3 mb-4">
                      <span className="text-2xl">?ƒ</span>
                      <h4 className="font-bold text-emerald-300">Exercise Guide</h4>
                    </div>
                    <p className="text-sm text-slate-300 whitespace-pre-line leading-relaxed">{strategies[result.careType].exerciseGuide}</p>
                  </div>
                  {/* 4. Ritual */}
                  <div className="bg-white/10 backdrop-blur-md rounded-2xl p-6 border border-white/10 hover:bg-white/15 transition-colors">
                    <div className="flex items-center gap-3 mb-4">
                      <span className="text-2xl">?§ </span>
                      <h4 className="font-bold text-amber-300">Pre-Study Ritual</h4>
                    </div>
                    <p className="text-sm text-slate-300 whitespace-pre-line leading-relaxed">{strategies[result.careType].preStudyRoutine}</p>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </Layout>
    );
  }

  return null;
};

export default App;
